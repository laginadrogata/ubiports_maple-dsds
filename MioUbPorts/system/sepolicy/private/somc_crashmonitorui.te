userdebug_or_eng(`
    # Access to crash files via /sdcard/ | /data/media/0/ | /usbdisk | /sdcard1
    # Diag: Restricting access to isolated_app & ephemeral_app caused due to neverallow policy
    allow { appdomain -isolated_app -ephemeral_app } sdcard_type:file r_file_perms;
    allow { appdomain -isolated_app -ephemeral_app } sdcard_type:dir r_dir_perms;

    allow system_app crashdata_data_file:file r_file_perms;

    # communicate to crashmonitorns
    binder_use(system_app)

    # create /data/media/0/CrashDump if not existing
    allow system_app crashdata_data_file:dir create_dir_perms;
')
